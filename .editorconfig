# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# zig fmt uses 4-space indentation and is the source of truth for .zig files.
[*.{zig,zon}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
max_line_length = off
trim_trailing_whitespace = false
